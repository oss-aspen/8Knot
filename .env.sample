AUGUR_DATABASE=augur
AUGUR_HOST=mock-db
AUGUR_PASSWORD=augur
AUGUR_PORT=5432
AUGUR_SCHEMA=augur_data
AUGUR_USERNAME=augur

DEBUG_8KNOT=True
REDIS_PASSWORD=1234
DEFAULT_SEARCHBAR_LABEL=chaoss
POSTGRES_PASSWORD=somepassword

AUGUR_LOGIN_ENABLED=False
# Secret key used for cryptographic session cookie signing.
# only needed if AUGUR_LOGIN_ENABLED=True
#SECRET_KEY=somethingsecret

# Durable application datastore (share links). Separate from the disposable
# cache so shared URLs survive cache resets. Defaults below match the
# docker-compose "postgres-app" service; override only for custom deployments.
#APP_DB_NAME=eightknot_app
#APP_DB_HOST=postgres-app
#APP_DB_PORT=5432
# APP_DB_USER / APP_DB_PASSWORD default to the cache's postgres user / POSTGRES_PASSWORD.
