AUGUR_DATABASE=augur
AUGUR_HOST=mock-db
AUGUR_PASSWORD=augur
AUGUR_PORT=5432

# Two-schema search path: aveloxis_augur_data has views with Augur column names
# for tables that differ (repo, repo_info, issues, pull_requests, releases).
# aveloxis_data is the fallback for all other tables (commits, contributors, etc.)
AUGUR_SCHEMA=aveloxis_augur_data, aveloxis_data

DEBUG_8KNOT=True
REDIS_PASSWORD=1234
DEFAULT_SEARCHBAR_LABEL=chaoss
POSTGRES_PASSWORD=somepassword

AUGUR_LOGIN_ENABLED=False
# Secret key used for cryptographic session cookie signing.
# only needed if AUGUR_LOGIN_ENABLED=True
#SECRET_KEY=somethingsecret
