AUGUR_DATABASE=augur
AUGUR_HOST=mock-db
AUGUR_PASSWORD=augur
AUGUR_PORT=5432
AUGUR_SCHEMA=data,augur_data
AUGUR_USERNAME=augur
# Bound how long augur keeps working on our behalf, so queries don't outlive a
# shut-down 8Knot instance. Milliseconds.
AUGUR_STATEMENT_TIMEOUT_MS=500000
AUGUR_ENGINE_STATEMENT_TIMEOUT_MS=1800000
AUGUR_IDLE_TX_TIMEOUT_MS=120000

DEBUG_8KNOT=True
REDIS_PASSWORD=1234
DEFAULT_SEARCHBAR_LABEL=chaoss
POSTGRES_PASSWORD=somepassword

AUGUR_LOGIN_ENABLED=False
# Secret key used for cryptographic session cookie signing.
# only needed if AUGUR_LOGIN_ENABLED=True
#SECRET_KEY=somethingsecret
